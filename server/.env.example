PORT=3000
HOST=0.0.0.0
DB_USER=sa
DB_PASSWORD=
DB_NAME=SupermarketFlyDB
DB_SERVER=localhost
DB_PORT=1433
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=supermarket_flybot
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_BASE_URL=
# Tùy chọn: effect_id lấy từ Message.effect_id trên Telegram; để trống thì bot chạy bình thường.
TELEGRAM_EFFECT_SUCCESS_ID=
TELEGRAM_EFFECT_ALERT_ID=

PAYMENT_PROVIDER=momo
PAYMENT_IPN_URL=
PAYMENT_RETURN_URL=
# Ví dụ tunnel:
# PAYMENT_IPN_URL=https://xxxx.trycloudflare.com/api/payments/gateway/ipn
# PAYMENT_RETURN_URL=https://xxxx.trycloudflare.com/api/payments/gateway/return

# 3 mã: PUBLIC SAMPLE — copy từ
# https://github.com/momo-wallet/payment/blob/master/nodejs/MoMo.js
# KHÔNG phải M4B / merchant riêng của nhóm.
# CẤM commit .env. CẤM điền secret vào file example này.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PUBLIC_KEY=
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_URL=https://test-payment.momo.vn/v2/gateway/api/query
# CẤM mặc định https://payment.momo.vn

# Plan B only — không dùng ở P1 mặc định
# PAYMENT_PROVIDER=momo_simulator
# MOMO_SIMULATOR_PUBLIC_URL=

# Giữ chỗ VNPay (P1 chưa bắt buộc chạy)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
