PORT=3000
HOST=0.0.0.0
DB_USER=sa
DB_PASSWORD=
DB_NAME=SupermarketFlyDB
DB_SERVER=localhost
DB_PORT=1433
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=supermarket_flybot
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_BASE_URL=
# start:momo ghi TELEGRAM_WEBHOOK_URL + TELEGRAM_PUBLIC_BASE_URL từ tunnel hiện tại.
# Trống = polling. setWebhook lỗi nhưng getMe OK → fallback polling (POS vẫn bán).
# Tùy chọn: effect_id lấy từ Message.effect_id trên Telegram; để trống thì bot chạy bình thường.
TELEGRAM_EFFECT_SUCCESS_ID=
TELEGRAM_EFFECT_ALERT_ID=

PAYMENT_PROVIDER=momo
PAYMENT_IPN_URL=
PAYMENT_RETURN_URL=
# Ví dụ tunnel:
# PAYMENT_IPN_URL=https://xxxx.trycloudflare.com/api/payments/gateway/ipn
# PAYMENT_RETURN_URL=https://xxxx.trycloudflare.com/api/payments/gateway/return

# 3 mã: PUBLIC SAMPLE — copy từ
# https://github.com/momo-wallet/payment/blob/master/nodejs/MoMo.js
# KHÔNG phải M4B / merchant riêng của nhóm.
# CẤM commit .env. CẤM điền secret vào file example này.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PUBLIC_KEY=
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_URL=https://test-payment.momo.vn/v2/gateway/api/query
# CẤM mặc định https://payment.momo.vn

# Plan B only — không dùng ở P1 mặc định
# PAYMENT_PROVIDER=momo_simulator
# MOMO_SIMULATOR_PUBLIC_URL=

# Giữ chỗ VNPay (P1 chưa bắt buộc chạy)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=

# Trợ lý AI — secret để TRỐNG trong example. CẤM commit .env.
# Mặc định Genspark (OpenAI-compatible llm_proxy). Có thể đổi codecraft | gemini | openai | ollama.
ASSISTANT_PROVIDER=genspark
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://www.genspark.ai/api/llm_proxy/v1
ASSISTANT_MODEL=claude-haiku-4-5
ASSISTANT_OLLAMA_URL=
ASSISTANT_OLLAMA_MODEL=llama3.2
ASSISTANT_TIMEOUT_MS=25000
ASSISTANT_MAX_QUESTION=500
ASSISTANT_DAILY_LIMIT=40
# Telegram /ask — cùng assistantService với Electron. 1 = bật, khác 1 = tắt.
TELEGRAM_ASK=1
